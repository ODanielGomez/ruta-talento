rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /admins/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || admin());
      allow list, write: if admin();
    }
    match /catalogos/{id} { allow read, write: if admin(); }
    match /trabajadores/{id} { allow read, write: if admin(); }
    match /rutas/{codigo} {
      allow get: if resource.data.activo == true || admin();
      allow list, create, delete: if admin();
      allow update: if admin() || (
        resource.data.activo == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completadas', 'actualizado']) &&
        request.resource.data.completadas is list &&
        request.resource.data.completadas.size() <= resource.data.misiones.size() &&
        request.resource.data.actualizado == request.time
      );
    }
    match /{document=**} { allow read, write: if false; }
  }
}
